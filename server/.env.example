# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/cse-vssut

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# App
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional comma-separated additional frontend origins (preview/staging domains)
# CLIENT_URLS=https://staging.example.com,https://app.example.com
# Allow *.vercel.app preview domains in production CORS checks (default true)
# Set to false to disable.
# ALLOW_VERCEL_PREVIEWS=true
HOD_NAME=Prof. Himansu Sekhar Behera

# Admin seed (npm run seed -w cse-vssut-server)
ADMIN_EMAIL=admin@csevssut.ac.in
ADMIN_PASSWORD=

# Optional: Google Gemini for open-ended chat (common questions work without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: Cloudinary for faculty photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
